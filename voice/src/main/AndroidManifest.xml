<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dictation records in memory only; asked for on first use (see MicrophonePermissionFlow). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- A keyboard without a microphone still types. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application>
        <activity
            android:name=".RecordAudioPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.UltimateKeys.Transparent" />
    </application>
</manifest>
